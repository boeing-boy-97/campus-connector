{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "if [ -d apps ]; then (cd apps/student && npm run build) && mkdir -p dist && cp -r apps/student/dist/. dist/; else npm run build; fi",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
