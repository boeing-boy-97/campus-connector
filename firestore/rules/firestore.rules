rules_version = '2';

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║         CAMPUS CONNECT — FIRESTORE SECURITY RULES                       ║
// ║                                                                          ║
// ║  CRITICAL: college_id isolation is enforced HERE at DB layer.           ║
// ║  A modified APK cannot bypass these rules.                              ║
// ║                                                                          ║
// ║  Role hierarchy: admin > moderator > student                            ║
// ╚══════════════════════════════════════════════════════════════════════════╝

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function tokenRole() {
      return request.auth.token.get('role', 'student');
    }

    function isAdmin() {
      return isAuthenticated() && tokenRole() == 'admin';
    }

    function isModerator() {
      return isAuthenticated() && (tokenRole() == 'admin' || tokenRole() == 'moderator');
    }

    function isStudent() {
      return isAuthenticated() && tokenRole() == 'student';
    }

    function isSelf(userId) {
      return isAuthenticated() && uid() == userId;
    }

    // Returns the current student's document
    function getMyProfile() {
      return get(/databases/$(database)/documents/students/$(uid())).data;
    }

    // Returns a specific student's document
    function getStudentDoc(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data;
    }

    // Same college check — THE critical isolation function
    function sameCollege(targetCollegeId) {
      return isAuthenticated()
        && getMyProfile().college_id == targetCollegeId;
    }

    // Is the current user's profile verified?
    function isVerified() {
      return isAuthenticated()
        && getMyProfile().verification_status == 'approved';
    }

    // Is student A blocked by student B or vice versa?
    function notBlocked(studentIdA, studentIdB) {
      return !exists(/databases/$(database)/documents/blocks/$(studentIdA + '_' + studentIdB))
        && !exists(/databases/$(database)/documents/blocks/$(studentIdB + '_' + studentIdA));
    }

    // Validate string field length
    function validString(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    // Check if a match exists between two students
    function matchExists(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId));
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COLLEGES COLLECTION
    // Any authenticated user can read colleges (needed for domain lookup)
    // Only admins can create/update colleges
    // ─────────────────────────────────────────────────────────────────────────
    match /colleges/{collegeId} {
      allow read: if isAuthenticated();
      // College lifecycle writes are validated and audited by Cloud Functions.
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // STUDENTS COLLECTION
    // ─────────────────────────────────────────────────────────────────────────
    match /students/{studentId} {

      // Student documents contain private identity and consent fields, so peers
      // receive an allowlisted profile through getProfile/recommendations instead.
      allow read: if isSelf(studentId) || isAdmin();

      // Profile lifecycle writes are validated and rate-limited by Cloud Functions.
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // VERIFICATION REQUESTS
    // ─────────────────────────────────────────────────────────────────────────
    match /verification_requests/{requestId} {
      // Student can read their own request; admins/moderators can read all
      allow read: if isModerator()
        || (isAuthenticated() && resource.data.student_id == uid());

      // Submission and review are atomic, validated Cloud Function operations.
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CONNECT REQUESTS (before mutual match)
    // ─────────────────────────────────────────────────────────────────────────
    match /connect_requests/{requestId} {
      allow read: if isAuthenticated()
        && (resource.data.from_id == uid() || resource.data.to_id == uid());

      // Requests are created/responded to transactionally by Cloud Functions.
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MATCHES
    // ─────────────────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      // Both matched students can read; admins can read all
      allow read: if isAdmin()
        || (isAuthenticated()
            && (resource.data.student_a_id == uid()
                || resource.data.student_b_id == uid()));

      // Match transitions and counters are owned by Cloud Functions.
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MESSAGES
    // ─────────────────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      // Only the two matched students can read messages
      allow read: if isAuthenticated() && (
        resource.data.sender_id == uid()
        || exists(/databases/$(database)/documents/matches/$(resource.data.match_id))
        && (
          get(/databases/$(database)/documents/matches/$(resource.data.match_id)).data.student_a_id == uid()
          || get(/databases/$(database)/documents/matches/$(resource.data.match_id)).data.student_b_id == uid()
        )
      );

      // Message sending, read receipts, and deletion use protected callables.
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // REPORTS
    // ─────────────────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Reporter can read their own reports; moderators can read all
      allow read: if isModerator()
        || (isAuthenticated() && resource.data.reporter_id == uid());

      // Reports and reviews are validated, rate-limited, and audited by callables.
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // BLOCKS
    // Document ID format: "{blocker_id}_{blocked_id}"
    // ─────────────────────────────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow read: if isAuthenticated()
        && (resource.data.blocker_id == uid() || resource.data.blocked_id == uid());

      // Block state and automatic unmatching are handled by Cloud Functions.
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ADMIN AUDIT LOG
    // Only admins can read/write
    // ─────────────────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Written only by Cloud Functions
    }

    // ─────────────────────────────────────────────────────────────────────────
    // NOTIFICATIONS
    // ─────────────────────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.user_id == uid();
      allow write: if false; // Written only by Cloud Functions
    }

    // ─────────────────────────────────────────────────────────────────────────
    // DEFAULT DENY — catch-all
    // ─────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
