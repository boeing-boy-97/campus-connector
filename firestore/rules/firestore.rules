rules_version = '2';

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║         CAMPUS CONNECT — FIRESTORE SECURITY RULES                       ║
// ║                                                                          ║
// ║  CRITICAL: college_id isolation is enforced HERE at DB layer.           ║
// ║  A modified APK cannot bypass these rules.                              ║
// ║                                                                          ║
// ║  Role hierarchy: admin > moderator > student                            ║
// ╚══════════════════════════════════════════════════════════════════════════╝

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function tokenRole() {
      return request.auth.token.get('role', 'student');
    }

    function isAdmin() {
      return isAuthenticated() && tokenRole() == 'admin';
    }

    function isModerator() {
      return isAuthenticated() && (tokenRole() == 'admin' || tokenRole() == 'moderator');
    }

    function isStudent() {
      return isAuthenticated() && tokenRole() == 'student';
    }

    function isSelf(userId) {
      return isAuthenticated() && uid() == userId;
    }

    // Returns the current student's document
    function getMyProfile() {
      return get(/databases/$(database)/documents/students/$(uid())).data;
    }

    // Returns a specific student's document
    function getStudentDoc(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data;
    }

    // Same college check — THE critical isolation function
    function sameCollege(targetCollegeId) {
      return isAuthenticated()
        && getMyProfile().college_id == targetCollegeId;
    }

    // Is the current user's profile verified?
    function isVerified() {
      return isAuthenticated()
        && getMyProfile().verification_status == 'approved';
    }

    // Is student A blocked by student B or vice versa?
    function notBlocked(studentIdA, studentIdB) {
      return !exists(/databases/$(database)/documents/blocks/$(studentIdA + '_' + studentIdB))
        && !exists(/databases/$(database)/documents/blocks/$(studentIdB + '_' + studentIdA));
    }

    // Validate string field length
    function validString(field, maxLen) {
      return field is string && field.size() <= maxLen;
    }

    // Check if a match exists between two students
    function matchExists(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId));
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COLLEGES COLLECTION
    // Any authenticated user can read colleges (needed for domain lookup)
    // Only admins can create/update colleges
    // ─────────────────────────────────────────────────────────────────────────
    match /colleges/{collegeId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false; // Never hard-delete colleges
    }

    // ─────────────────────────────────────────────────────────────────────────
    // STUDENTS COLLECTION
    // ─────────────────────────────────────────────────────────────────────────
    match /students/{studentId} {

      // Student can read their own profile (always)
      // Verified students can read OTHER verified students from SAME college only
      // Admins AND moderators can read any student (needed for the admin
      // dashboard, users list, and verification queue enrichment)
      allow read: if isSelf(studentId)
        || isModerator()
        || (isVerified()
            && sameCollege(resource.data.college_id)
            && resource.data.verification_status == 'approved');

      // Only the student themselves can create their own profile (during signup)
      allow create: if isSelf(studentId)
        && request.resource.data.keys().hasAll([
          'college_id', 'college_email', 'full_name',
          'verification_status', 'created_at'
        ])
        && request.resource.data.verification_status == 'pending'
        && validString(request.resource.data.full_name, 100)
        && validString(request.resource.data.bio, 500);

      // Student can update their own profile (cannot change college_id or verification_status)
      // Admins can update any field
      allow update: if isAdmin()
        || (isSelf(studentId)
            && request.resource.data.college_id == resource.data.college_id
            && request.resource.data.college_email == resource.data.college_email
            && request.resource.data.verification_status == resource.data.verification_status
            && validString(request.resource.data.bio, 500)
            && validString(request.resource.data.full_name, 100));

      // Only admins can delete (soft-delete preferred)
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // VERIFICATION REQUESTS
    // ─────────────────────────────────────────────────────────────────────────
    match /verification_requests/{requestId} {
      // Student can read their own request; admins/moderators can read all
      allow read: if isModerator()
        || (isAuthenticated() && resource.data.student_id == uid());

      // Student can create a verification request for themselves
      allow create: if isAuthenticated()
        && request.resource.data.student_id == uid()
        && request.resource.data.review_status == 'pending';

      // Only moderators/admins can update (review the request)
      allow update: if isModerator();

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CONNECT REQUESTS (before mutual match)
    // ─────────────────────────────────────────────────────────────────────────
    match /connect_requests/{requestId} {
      allow read: if isAuthenticated()
        && (resource.data.from_id == uid() || resource.data.to_id == uid());

      allow create: if isVerified()
        && request.resource.data.from_id == uid()
        && sameCollege(getStudentDoc(request.resource.data.to_id).college_id)
        && notBlocked(uid(), request.resource.data.to_id);

      // Only the recipient can accept/decline
      allow update: if isAuthenticated()
        && resource.data.to_id == uid();

      allow delete: if isAuthenticated()
        && resource.data.from_id == uid();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MATCHES
    // ─────────────────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      // Both matched students can read; admins can read all
      allow read: if isAdmin()
        || (isAuthenticated()
            && (resource.data.student_a_id == uid()
                || resource.data.student_b_id == uid()));

      // Matches are ONLY created by Cloud Functions (acceptRequest)
      allow create: if false;

      // Students can unmatch (update status to 'unmatched')
      allow update: if isAuthenticated()
        && (resource.data.student_a_id == uid() || resource.data.student_b_id == uid())
        && request.resource.data.status == 'unmatched'
        && request.resource.data.student_a_id == resource.data.student_a_id
        && request.resource.data.student_b_id == resource.data.student_b_id;

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MESSAGES
    // ─────────────────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      // Only the two matched students can read messages
      allow read: if isAuthenticated() && (
        resource.data.sender_id == uid()
        || exists(/databases/$(database)/documents/matches/$(resource.data.match_id))
        && (
          get(/databases/$(database)/documents/matches/$(resource.data.match_id)).data.student_a_id == uid()
          || get(/databases/$(database)/documents/matches/$(resource.data.match_id)).data.student_b_id == uid()
        )
      );

      // Sender must be part of the match; match must be active
      allow create: if isVerified()
        && request.resource.data.sender_id == uid()
        && matchExists(request.resource.data.match_id)
        && get(/databases/$(database)/documents/matches/$(request.resource.data.match_id)).data.status == 'active'
        && (
          get(/databases/$(database)/documents/matches/$(request.resource.data.match_id)).data.student_a_id == uid()
          || get(/databases/$(database)/documents/matches/$(request.resource.data.match_id)).data.student_b_id == uid()
        )
        && validString(request.resource.data.text, 2000);

      // Only the recipient can mark as read
      allow update: if isAuthenticated()
        && resource.data.sender_id != uid()
        && request.resource.data.read_at != null
        && request.resource.data.text == resource.data.text;

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // REPORTS
    // ─────────────────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Reporter can read their own reports; moderators can read all
      allow read: if isModerator()
        || (isAuthenticated() && resource.data.reporter_id == uid());

      // Any verified student can file a report
      allow create: if isVerified()
        && request.resource.data.reporter_id == uid()
        && request.resource.data.reported_id != uid()
        && request.resource.data.status == 'pending'
        && validString(request.resource.data.reason, 1000);

      // Only moderators/admins can update report status
      allow update: if isModerator();

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // BLOCKS
    // Document ID format: "{blocker_id}_{blocked_id}"
    // ─────────────────────────────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow read: if isAuthenticated()
        && (resource.data.blocker_id == uid() || resource.data.blocked_id == uid());

      allow create: if isVerified()
        && request.resource.data.blocker_id == uid()
        && request.resource.data.blocked_id != uid();

      // Blocker can unblock (delete)
      allow delete: if isAuthenticated()
        && resource.data.blocker_id == uid();

      allow update: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ADMIN AUDIT LOG
    // Only admins can read/write
    // ─────────────────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Written only by Cloud Functions
    }

    // ─────────────────────────────────────────────────────────────────────────
    // NOTIFICATIONS
    // ─────────────────────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.user_id == uid();
      allow write: if false; // Written only by Cloud Functions
    }

    // ─────────────────────────────────────────────────────────────────────────
    // OTP RECORDS — written/read only by Cloud Functions
    // ─────────────────────────────────────────────────────────────────────────
    match /otp_records/{email} {
      allow read, write: if false; // Managed entirely by Cloud Functions
    }

    match /otp_store/{email} {
      allow read, write: if false; // Managed entirely by Cloud Functions
    }

    // ─────────────────────────────────────────────────────────────────────────
    // RATE LIMITS — written/read only by Cloud Functions
    // ─────────────────────────────────────────────────────────────────────────
    match /rate_limits/{limitId} {
      allow read, write: if false; // Managed entirely by Cloud Functions
    }

    // ─────────────────────────────────────────────────────────────────────────
    // DEFAULT DENY — catch-all
    // ─────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
