rules_version = '2';

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║         CAMPUS CONNECT — FIRESTORE SECURITY RULES                       ║
// ║                                                                          ║
// ║  Model: every collection is READ-ONLY to clients and DEFAULT-DENY.       ║
// ║  All writes are performed by Cloud Functions with the Admin SDK, which   ║
// ║  bypasses these rules — that is where validation, rate limiting,         ║
// ║  authorization and audit logging live. A modified client cannot forge    ║
// ║  a write, and cannot widen its own read scope.                          ║
// ║                                                                          ║
// ║  Peer profile data is never read directly from `students`; peers only    ║
// ║  ever receive the allowlisted projection returned by the getProfile and  ║
// ║  getRecommendations callables.                                           ║
// ║                                                                          ║
// ║  Role hierarchy: admin > moderator > student (from Auth custom claims).  ║
// ╚══════════════════════════════════════════════════════════════════════════╝

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPERS
    //
    // All helpers read from the caller's ID token only. Deliberately avoiding
    // get()/exists() lookups here keeps rule evaluation to zero extra document
    // reads and prevents a rule from depending on data a client can influence.
    // ─────────────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function tokenRole() {
      return request.auth.token.get('role', 'student');
    }

    function isAdmin() {
      return isAuthenticated() && tokenRole() == 'admin';
    }

    // Moderators and admins share the moderation surface. The admin panel reads
    // these collections with the client SDK, so moderator reads must be allowed
    // here or the panel silently renders empty tables.
    function isModerator() {
      return isAuthenticated() && (tokenRole() == 'admin' || tokenRole() == 'moderator');
    }

    function isSelf(userId) {
      return isAuthenticated() && uid() == userId;
    }

    // Is the caller a participant of the given match?
    function isMatchParticipant(matchId) {
      let match = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return isAuthenticated()
        && (match.student_a_id == uid() || match.student_b_id == uid());
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COLLEGES — any signed-in user may read (needed for branding lookup).
    // Lifecycle writes are validated and audited by Cloud Functions.
    // ─────────────────────────────────────────────────────────────────────────
    match /colleges/{collegeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // STUDENTS — a student document holds private identity, contact and consent
    // fields, so peers must never read it directly. Moderators need read access
    // for the admin panel's user management and moderation views.
    // ─────────────────────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if isSelf(studentId) || isModerator();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // VERIFICATION REQUESTS
    // ─────────────────────────────────────────────────────────────────────────
    match /verification_requests/{requestId} {
      allow read: if isModerator()
        || (isAuthenticated() && resource.data.student_id == uid());
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CONNECT REQUESTS (before a mutual match exists)
    // ─────────────────────────────────────────────────────────────────────────
    match /connect_requests/{requestId} {
      allow read: if isModerator()
        || (isAuthenticated()
            && (resource.data.from_id == uid() || resource.data.to_id == uid()));
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MATCHES — both participants can read. `participant_ids` supports the
    // single array-contains listener used by the clients.
    // ─────────────────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isModerator()
        || (isAuthenticated()
            && (resource.data.student_a_id == uid()
                || resource.data.student_b_id == uid()));
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MESSAGES — readable only by the two participants of the parent match.
    // Moderators are deliberately NOT granted blanket read access to private
    // conversations; message evidence reaches moderation through reports.
    // ─────────────────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isAuthenticated()
        && (resource.data.sender_id == uid() || isMatchParticipant(resource.data.match_id));
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // REPORTS — the reporter can see their own submissions; moderators see all.
    // ─────────────────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isModerator()
        || (isAuthenticated() && resource.data.reporter_id == uid());
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // BLOCKS — document ID is a sha256 of the directional pair, so the ID
    // itself leaks nothing. Either side may read a block that involves them.
    // ─────────────────────────────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow read: if isModerator()
        || (isAuthenticated()
            && (resource.data.blocker_id == uid() || resource.data.blocked_id == uid()));
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // AUDIT LOGS — admin-only, append-only via Cloud Functions.
    // ─────────────────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // NOTIFICATIONS — owner-only.
    // ─────────────────────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.user_id == uid();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // OTP RECORDS / RATE LIMITS — server-side only. An OTP hash or a rate-limit
    // counter must never be readable by a client, not even its owner.
    // ─────────────────────────────────────────────────────────────────────────
    match /otp_records/{recordId} {
      allow read, write: if false;
    }

    match /rate_limits/{bucketId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // DEFAULT DENY — catch-all for any collection added in future.
    // ─────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
