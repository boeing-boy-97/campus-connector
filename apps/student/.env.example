# Campus Connect — Student Web App Environment Variables
# Copy to .env.local for local overrides

# Set to true to connect to local Firebase emulators (auth: 9099, firestore: 8080, functions: 5001)
VITE_USE_FIREBASE_EMULATORS=true

# Firebase Project Configuration (from Firebase Console → Project Settings)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-V0ZKW6LDGB
