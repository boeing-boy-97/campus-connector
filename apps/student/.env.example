# ── Campus Connector — student web app ────────────────────────────────────────
# Copy to `.env.local` and fill in the values from the Firebase console:
#   Project settings → Your apps → SDK setup and configuration
#
# These values are public by design (they identify the project; access is
# governed by Firestore/Storage Security Rules), but they are NOT optional:
# the app refuses to start without them rather than silently pointing at the
# wrong project.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Local development against the Firebase emulator suite ────────────────────
# Set to `true` to route Auth, Firestore, Functions and Storage to the local
# emulators started by `npm run emulator`.
VITE_USE_FIREBASE_EMULATORS=false
# Host the emulators are reachable on (default 127.0.0.1).
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
