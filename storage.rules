rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isModerator() {
      return request.auth != null
        && (request.auth.token.role == 'admin' || request.auth.token.role == 'moderator');
    }

    function isMatchParticipant(matchId) {
      return isAuth()
        && (
          firestore.get(
            /databases/(default)/documents/matches/$(matchId)
          ).data.student_a_id == request.auth.uid
          || firestore.get(
            /databases/(default)/documents/matches/$(matchId)
          ).data.student_b_id == request.auth.uid
        );
    }

    match /verification_photos/{userId}/{allPaths=**} {
      // IDs and uniform photos are sensitive. They are never visible to other students.
      allow read: if isAuth()
        && (request.auth.uid == userId || isModerator());
      allow create: if isAuth()
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAuth()
        && request.auth.uid == userId;
      allow update: if false;
    }

    match /chat_media/{matchId}/{allPaths=**} {
      // Chat media is private to the two participants in the referenced match.
      allow read: if isMatchParticipant(matchId);
      allow create: if isMatchParticipant(matchId)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|video/mp4');
      allow delete: if isMatchParticipant(matchId);
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
