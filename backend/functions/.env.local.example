# CAMPUS CONNECT — SMTP Email Configuration
# Copy this to: backend/functions/.env.local
# This file should NOT be committed to git (it's in .gitignore)

# ────────────────────────────────────────────────────────────────────────────
# GMAIL SMTP (Recommended for testing)
# ────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ⚠️ IMPORTANT: 
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Get App Password from: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password above (remove spaces)
# 4. Example: 
#    SMTP_PASS=abcdefghijklmnop  ← 16 characters, no spaces

# ────────────────────────────────────────────────────────────────────────────
# SENDGRID SMTP (Production recommended)
# ────────────────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxx

# ────────────────────────────────────────────────────────────────────────────
# AWS SES SMTP
# ────────────────────────────────────────────────────────────────────────────
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your-iam-user
# SMTP_PASS=your-smtp-password

# ────────────────────────────────────────────────────────────────────────────
# RESEND SMTP
# ────────────────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxxx
