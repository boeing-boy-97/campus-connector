{
  "name": "campus-connect-functions",
  "description": "Campus Connect — Firebase Cloud Functions (TypeScript)",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "lib/backend/functions/src/server.js",
  "scripts": {
    "build": "npx tsc",
    "watch": "npx tsc --watch",
    "serve": "npm run build && npx firebase emulators:start --only functions",
    "shell": "npm run build && npx firebase functions:shell",
    "start": "node lib/backend/functions/src/server.js",
    "deploy": "npx firebase deploy --only functions",
    "logs": "npx firebase functions:log",
    "lint": "npx eslint --ext .ts src/",
    "test": "npx jest --forceExit --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^4.9.0",
    "nodemailer": "^7.0.13",
    "object-inspect": "^1.13.4",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  }
}
