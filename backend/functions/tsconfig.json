{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../shared/*"],
      "@config/*": ["src/config/*"],
      "@utils/*": ["src/utils/*"],
      "@middleware/*": ["src/middleware/*"],
      "@services/*": ["src/services/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false
  },
  "compileOnSave": true,
  "include": [
    "src/**/*",
    "../../shared/**/*"
  ],
  "exclude": [
    "lib",
    "node_modules",
    "src/test/**/*",
    "**/*.test.ts"
  ]
}
