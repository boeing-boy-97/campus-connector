# Campus Connect — Root environment template
# Copy to .env and fill with your project values.
# Do not commit real secrets or service-account files.

# Frontend Firebase config for Vercel/Web apps
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel Frontend API URL (Points to Render backend)
VITE_API_URL=https://campus-connector.onrender.com
VITE_USE_FIREBASE_EMULATORS=false

# Render Backend Configuration
PORT=5000
FRONTEND_URL=https://campus-connector-student.vercel.app
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Or alternatively set entire JSON string:
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# SMTP configuration for OTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-smtp-app-password

# Local emulator hosts (for development)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
FIREBASE_FUNCTIONS_EMULATOR_HOST=localhost:5001
