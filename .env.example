# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  CAMPUS CONNECT — ENVIRONMENT VARIABLES                                  ║
# ║                                                                          ║
# ║  Copy to `.env` for local tooling. NEVER commit a filled-in copy —        ║
# ║  `.env` and `.env.local` are gitignored.                                 ║
# ║                                                                          ║
# ║  Web app variables belong in the app that uses them:                     ║
# ║    apps/student/.env.local   (see apps/student/.env.example)             ║
# ║    apps/admin/.env.local     (see apps/admin/.env.example)               ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Deployment target ────────────────────────────────────────────────────────
# Required by scripts/deployment/deploy.sh. Must match VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=your-project-id

# ── Firebase web client config (public, but required) ────────────────────────
# From: Firebase console → Project settings → Your apps → SDK setup and config.
# These identify the project; access is governed by Security Rules. They are NOT
# secrets, but they are also NOT optional — both web apps refuse to start
# without them rather than silently connecting to the wrong project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Cloud Functions: SMTP for OTP delivery (SECRET) ─────────────────────────
# Do NOT put real values in a deployed .env file. Store them as Firebase secrets:
#
#   firebase functions:secrets:set SMTP_HOST
#   firebase functions:secrets:set SMTP_PORT
#   firebase functions:secrets:set SMTP_USER
#   firebase functions:secrets:set SMTP_PASS
#   firebase functions:secrets:set SMTP_FROM
#
# Without these, sendOtp reports "E-mail delivery is not configured" instead of
# pretending to send a code. Any SMTP provider works (SendGrid, Mailgun, Amazon
# SES, Postmark, Google Workspace…). Port 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Envelope sender. Use an address on a domain you control, with SPF/DKIM set up,
# or college mail servers will reject or spam-folder the message.
SMTP_FROM=Campus Connect <noreply@yourdomain.example>

# ── Local Cloud Functions development (Admin SDK credentials) ───────────────
# Only needed when running functions against a REAL project from your machine.
# Not needed for the emulator suite. Never commit the key file.
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk-key.json

# ── Firebase emulator suite (local development only) ────────────────────────
# Start with: npm run emulator
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
